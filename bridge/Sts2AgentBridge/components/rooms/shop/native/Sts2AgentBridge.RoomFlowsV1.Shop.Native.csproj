<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Sts2AgentBridge.RoomFlowsV1.Shop.Native</AssemblyName>
    <RootNamespace>Sts2AgentBridge.Successors.RoomFlowsV1.Shop.Native</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Target Name="ValidatePinnedGameData" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(STS2GameDataDir)' == ''" Text="STS2GameDataDir is required." />
    <Error Condition="'$(STS2GameDataDir)' != '' and !$([System.IO.Path]::IsPathFullyQualified('$(STS2GameDataDir)'))" Text="STS2GameDataDir must be absolute." />
    <Error Condition="'$(STS2GameDataDir)' != '' and !Exists('$(STS2GameDataDir)/sts2.dll')" Text="Pinned sts2.dll is missing." />
    <Error Condition="'$(STS2GameDataDir)' != '' and !Exists('$(STS2GameDataDir)/GodotSharp.dll')" Text="Pinned GodotSharp.dll is missing." />
  </Target>
  <ItemGroup>
    <Compile Include="PinnedShopV1NativeAdapter.cs" />
    <Compile Include="ShopPotionOwnership.cs" />
    <Compile Include="ShopRelicRules.cs" />
    <Compile Include="PinnedShopRemovalDispatch.cs" />
    <Compile Include="PinnedDeckCardChoice.cs" />
    <Compile Include="PinnedShopPickupDispatch.cs" />
    <Compile Include="../../../cards/native/CardSelectionV1NativeRules.cs" />
    <Compile Include="../../../items/native/PinnedPotionCapacity.cs" />
    <Compile Include="../../../items/native/PinnedPotionDiscard.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../core/Sts2AgentBridge.RoomFlowsV1.Shop.Core.csproj" />
    <ProjectReference Include="../../../cards/core/Sts2AgentBridge.CardSelectionV1.Core.csproj" />
    <Reference Include="0Harmony"><HintPath>$(STS2GameDataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="sts2"><HintPath>$(STS2GameDataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
