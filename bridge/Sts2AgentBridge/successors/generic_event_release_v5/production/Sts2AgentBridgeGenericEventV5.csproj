    <Compile Include="../../generic_event_v3/core/GenericEventV3Contracts.cs" Link="generic_event_v3/core/GenericEventV3Contracts.cs" />
    <Compile Include="../../generic_event_v3/core/GenericEventV3NativeContracts.cs" Link="generic_event_v3/core/GenericEventV3NativeContracts.cs" />
    <Compile Include="../../generic_event_v3/core/GenericEventV3Session.cs" Link="generic_event_v3/core/GenericEventV3Session.cs" />
    <Compile Include="../../generic_event_v3/wire/GenericEventV3WireService.cs" Link="generic_event_v3/wire/GenericEventV3WireService.cs" />
    <Compile Include="../../generic_event_v3/wire/GenericEventV3WireCodec.cs" Link="generic_event_v3/wire/GenericEventV3WireCodec.cs" />
    <Compile Include="../native/GenericEventV3RewardAdapter.cs" Link="generic_event_v3/native/GenericEventV3RewardAdapter.cs" />
    <Compile Include="../native/GenericEventV3RemovalAdapter.cs" Link="generic_event_v3/native/GenericEventV3RemovalAdapter.cs" />
    <Compile Include="../../generic_event_lifecycle_v1/native/GenericEventV3Binding.cs" Link="generic_event_v3/native/GenericEventV3Binding.cs" />
    <Compile Include="../native/GenericEventV3CardAdapter.cs" Link="generic_event_v3/native/GenericEventV3CardAdapter.cs" />
    <Compile Include="../../generic_event_v3/native/GenericEventV3Hooks.cs" Link="generic_event_v3/native/GenericEventV3Hooks.cs" />
    <Compile Include="../native/PinnedGenericEventV3NativeAdapter.cs" Link="generic_event_v3/native/PinnedGenericEventV3NativeAdapter.cs" />
