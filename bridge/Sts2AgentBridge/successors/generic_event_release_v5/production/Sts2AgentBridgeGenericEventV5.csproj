    <Compile Include="../../item_bootstrap_v1/operator/ItemPinnedFileIdentity.cs" Link="item_bootstrap_v1/operator/ItemPinnedFileIdentity.cs" />
    <Compile Include="../../item_bootstrap_v1/native/PinnedItemBuildGuard.cs" Link="item_bootstrap_v1/native/PinnedItemBuildGuard.cs" />
    <Compile Include="../runtime/GenericEventDiagnosticCode.cs" />
    <Compile Include="../runtime/GenericEventDiagnosticCodec.cs" />
    <Compile Include="../runtime/OwnedByteFrameQueue.cs" Link="generic_event_release_v5/runtime/OwnedByteFrameQueue.cs" />
    <Compile Include="../runtime/GenericEventTransportConfiguration.cs" Link="generic_event_release_v5/runtime/GenericEventTransportConfiguration.cs" />
    <Compile Include="../runtime/GenericEventTransportContracts.cs" Link="generic_event_release_v5/runtime/GenericEventTransportContracts.cs" />
    <Compile Include="../runtime/GenericEventTransportProtocol.cs" Link="generic_event_release_v5/runtime/GenericEventTransportProtocol.cs" />
    <Compile Include="../runtime/GenericEventTransportRuntime.cs" Link="generic_event_release_v5/runtime/GenericEventTransportRuntime.cs" />
    <Compile Include="../operator/GenericEventOperatorFiles.cs" Link="generic_event_release_v5/operator/GenericEventOperatorFiles.cs" />
    <Compile Include="../lifecycle/GenericEventBootstrapLifecycle.cs" Link="generic_event_release_v5/lifecycle/GenericEventBootstrapLifecycle.cs" />
    <Compile Include="../native/ProductionGenericEventRuntimeFactory.cs" Link="generic_event_release_v5/native/ProductionGenericEventRuntimeFactory.cs" />
    <Compile Include="../native/PinnedGenericEventHarmonyGuard.cs" Link="generic_event_release_v5/native/PinnedGenericEventHarmonyGuard.cs" />
