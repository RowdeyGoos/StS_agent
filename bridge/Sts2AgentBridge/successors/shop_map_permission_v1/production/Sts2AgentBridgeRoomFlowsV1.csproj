    <AssemblyName>Sts2AgentBridgeRoomFlowsV1</AssemblyName>
    <RootNamespace>Sts2AgentBridge.Successors.RoomReleaseV1</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
