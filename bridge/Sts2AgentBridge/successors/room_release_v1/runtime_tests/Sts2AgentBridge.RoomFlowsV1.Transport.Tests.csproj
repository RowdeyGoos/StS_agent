<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Sts2AgentBridge.RoomFlowsV1.Transport.Tests</AssemblyName>
    <RootNamespace>Sts2AgentBridge.Successors.RoomReleaseV1</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);ROOM_RELEASE_TEST_SEAM</DefineConstants>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>9.0</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../runtime/RoomFlowTransportContracts.cs" Link="runtime/RoomFlowTransportContracts.cs" />
    <Compile Include="../runtime/RoomFlowTransportConfiguration.cs" Link="runtime/RoomFlowTransportConfiguration.cs" />
    <Compile Include="../runtime/RoomFlowTransportProtocol.cs" Link="runtime/RoomFlowTransportProtocol.cs" />
    <Compile Include="../runtime/OwnedByteFrameQueue.cs" Link="runtime/OwnedByteFrameQueue.cs" />
    <Compile Include="../runtime/RoomFlowTransportRuntime.cs" Link="runtime/RoomFlowTransportRuntime.cs" />
    <Compile Include="../../item_transport_v1/runtime/kernel/FixedTimeAuthenticator.cs" Link="kernel/FixedTimeAuthenticator.cs" />
    <Compile Include="../../item_transport_v1/runtime/kernel/MonotonicTokenBucket.cs" Link="kernel/MonotonicTokenBucket.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../room_flows_v1/wire/Sts2AgentBridge.RoomFlowsV1.Wire.csproj" />
  </ItemGroup>
</Project>
