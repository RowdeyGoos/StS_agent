<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Sts2AgentBridge.ShopDiagnosticV1.Transport</AssemblyName>
    <RootNamespace>Sts2AgentBridge.Successors.ShopDiagnosticV1</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>9.0</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/IShopDiagnosticService.cs" Link="IShopDiagnosticService.cs" />
    <Compile Include="ShopDiagnosticTransportConfiguration.cs" />
    <Compile Include="ShopDiagnosticTransportProtocol.cs" />
    <Compile Include="OwnedByteFrameQueue.cs" />
    <Compile Include="ShopDiagnosticTransportRuntime.cs" />
    <Compile Include="../../item_transport_v1/runtime/kernel/FixedTimeAuthenticator.cs" Link="kernel/FixedTimeAuthenticator.cs" />
    <Compile Include="../../item_transport_v1/runtime/kernel/MonotonicTokenBucket.cs" Link="kernel/MonotonicTokenBucket.cs" />
  </ItemGroup>
</Project>
